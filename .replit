modules = ["python-3.11", "nodejs-22"]
run = "if [ ! -f .pythonlibs/.nanobot-deps-ready ]; then uv pip install --target .pythonlibs/lib/python3.11/site-packages -e . && touch .pythonlibs/.nanobot-deps-ready; fi && python scripts/replit_bootstrap.py && python -m nanobot webui --yes --no-open --port 5000 --host 0.0.0.0 --config ~/.nanobot/replit-config.json"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

